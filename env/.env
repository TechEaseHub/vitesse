# ========== 🌐 应用基本信息 ==========
# 应用名称
VITE_APP_TITLE = 'vitesse'
# 部署基础路径
VITE_APP_PUBLIC_BASE = /

# ========== 🔗 接口服务配置 ==========
# 服务的基础地址
VITE_SERVER_BASEURL =
# 接口路径的前缀
VITE_SERVER_PROXY =

# ========== 🛠️ 编译与调试配置 ==========
# 环境变量
NODE_ENV = 'default'
# 是否在构建产物中移除 console 和 debugger（true = 移除，false = 保留）
VITE_DELETE_CONSOLE = false
# 是否生成 source map 文件（用于调试定位）
VITE_SHOW_SOURCEMAP = true
# 是否启用自定义日志模块（true = 输出，false = 禁止）
VITE_LOG_ENABLED = true
